# ──────────────────────────────────────────
# 取引所設定
# ──────────────────────────────────────────
EXCHANGE=gmo                    # gmo or bybit

# GMO Coin API キー（https://coin.z.com/jp/corp/guide/api/）
API_KEY=your_gmo_api_key_here
API_SECRET=your_gmo_api_secret_here

# Bybit の場合は以下を使用
# API_KEY=your_bybit_api_key_here
# API_SECRET=your_bybit_api_secret_here

TRADING_MODE=paper              # paper or live

# ──────────────────────────────────────────
# 取引設定
# ──────────────────────────────────────────
SYMBOL=BTC/JPY                  # GMO: BTC/JPY, Bybit: BTC/USDT

# ──────────────────────────────────────────
# 初期資金
# ──────────────────────────────────────────
INITIAL_CAPITAL_JPY=10000       # GMO用（円）
INITIAL_CAPITAL_USDT=65         # Bybit用（USDT）

# ──────────────────────────────────────────
# Convex 連携
# ──────────────────────────────────────────
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=              # オプション（認証が必要な場合）
